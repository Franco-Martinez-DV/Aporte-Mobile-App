<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nueva Campaña Deportiva"
            android:textColor="#0F172A"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Imagen de Portada (Opcional)"
            android:textColor="#334155"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <ImageView
            android:id="@+id/ivPreviewPortada"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:scaleType="centerCrop"
            android:background="#E2E8F0"
            android:visibility="gone"
            android:layout_marginBottom="8dp"
            android:contentDescription="Vista previa de portada"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <Button
                android:id="@+id/btnSeleccionarImagen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Elegir Foto de Galería"
                android:backgroundTint="#EFF6FF"
                android:textColor="#0077FF"/>

            <Button
                android:id="@+id/btnQuitarImagen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Quitar"
                android:visibility="gone"
                android:backgroundTint="#FEE2E2"
                android:textColor="#CC0000"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Título"
            android:textColor="#334155"
            android:textStyle="bold"/>
        <EditText
            android:id="@+id/etTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej: Pasajes al Torneo Nacional"
            android:inputType="textCapSentences"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Categoría"
            android:textColor="#334155"
            android:textStyle="bold"/>
        <Spinner
            android:id="@+id/spCategoria"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descripción"
            android:textColor="#334155"
            android:textStyle="bold"/>
        <EditText
            android:id="@+id/etDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Detallá el objetivo y necesidad..."
            android:inputType="textMultiLine"
            android:minLines="3"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monto Objetivo ($)"
            android:textColor="#334155"
            android:textStyle="bold"/>
        <EditText
            android:id="@+id/etMontoObjetivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej: 150000"
            android:inputType="number"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fecha Límite (AAAA-MM-DD)"
            android:textColor="#334155"
            android:textStyle="bold"/>
        <EditText
            android:id="@+id/etFechaLimite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej: 2026-12-31"
            android:inputType="date"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Publicar Campaña"
            android:backgroundTint="#0077FF"
            android:textColor="#FFFFFF"/>

    </LinearLayout>
</ScrollView>