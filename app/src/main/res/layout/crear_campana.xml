<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nueva Campaña Deportiva"
            android:textColor="#0F172A"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Título"
            android:textColor="#334155"
            android:textStyle="bold"/>
        <EditText
            android:id="@+id/etTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej: Pasajes al Torneo Nacional"
            android:inputType="textCapSentences"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Categoría"
            android:textColor="#334155"
            android:textStyle="bold"/>
        <Spinner
            android:id="@+id/spCategoria"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descripción"
            android:textColor="#334155"
            android:textStyle="bold"/>
        <EditText
            android:id="@+id/etDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Detallá el objetivo y necesidad..."
            android:inputType="textMultiLine"
            android:minLines="3"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monto Objetivo ($)"
            android:textColor="#334155"
            android:textStyle="bold"/>
        <EditText
            android:id="@+id/etMontoObjetivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej: 150000"
            android:inputType="number"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fecha Límite (AAAA-MM-DD)"
            android:textColor="#334155"
            android:textStyle="bold"/>
        <EditText
            android:id="@+id/etFechaLimite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej: 2026-12-31"
            android:inputType="date"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Publicar Campaña"
            android:backgroundTint="#0284C7"
            android:textColor="#FFFFFF"/>

    </LinearLayout>
</ScrollView>